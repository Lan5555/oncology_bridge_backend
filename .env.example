# Add these server-only values to your existing application configuration.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PAYSTACK_SECRET_KEY=
FRONTEND_ORIGIN=https://your-frontend.example
CORS_ORIGIN=https://your-frontend.example
MARKETPLACE_RESERVATION_MINUTES=15

# Brevo transactional email (server-only API key, verified sender).
# Apply database/email-service.sql before deploying these changes.
EMAIL_ENABLED=false
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=OncoSourz
# Frontend route that accepts ?token= and POSTs token/password to reset-password.
PASSWORD_RESET_PATH=/reset-password
